# 画面理解与总结：openai / deepseek / qwen / kimi
AI_PROVIDER=openai
# 语音转写：openai / qwen。选 qwen 作为 AI_PROVIDER 时默认也使用 qwen 转写。
# ASR_PROVIDER=openai

# 只填写所选服务商需要的密钥。不要提交真实 .env。
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
KIMI_API_KEY=

# 各服务商预置官方接口地址及模型，可按需覆盖。
# OPENAI_BASE_URL=https://api.openai.com/v1
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# KIMI_BASE_URL=https://api.moonshot.cn/v1
# VISION_MODEL=gpt-4.1-mini
# SUMMARY_MODEL=gpt-4.1-mini
# TRANSCRIPTION_MODEL=whisper-1
# DEEPSEEK_VISION_MODEL=deepseek-flash
# DEEPSEEK_SUMMARY_MODEL=deepseek-flash
# QWEN_VISION_MODEL=qwen3-vl-plus
# QWEN_SUMMARY_MODEL=qwen-plus
# QWEN_ASR_MODEL=qwen3-asr-flash
# KIMI_VISION_MODEL=kimi-k2.6
# KIMI_SUMMARY_MODEL=kimi-k2.6
# TRANSCRIPTION_BASE_URL=https://example.com/v1
# TRANSCRIPTION_API_KEY=

DATA_DIR=./data
MAX_VIDEO_MINUTES=120
MAX_DOWNLOAD_MB=1024
MAX_FRAMES=24
FRAME_INTERVAL_SECONDS=90
MAX_CONCURRENT_TASKS=2
# COOKIES_FILE=/absolute/path/to/cookies.txt
# JS_RUNTIME_NODE=/absolute/path/to/node
# FFMPEG_BIN_DIR=/absolute/path/to/bin
