# OpenAI-compatible endpoint. Supply keys yourself; never commit .env.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
TRANSCRIPTION_MODEL=whisper-1
VISION_MODEL=gpt-4.1-mini
SUMMARY_MODEL=gpt-4.1-mini

# Optional: separate provider for speech recognition.
# TRANSCRIPTION_BASE_URL=https://example.com/v1
# TRANSCRIPTION_API_KEY=

DATA_DIR=./data
MAX_VIDEO_MINUTES=120
MAX_DOWNLOAD_MB=1024
MAX_FRAMES=24
FRAME_INTERVAL_SECONDS=90
MAX_CONCURRENT_TASKS=2
# Optional Netscape-format cookie file for sites that require login.
# COOKIES_FILE=/absolute/path/to/cookies.txt
# For full YouTube support, install Node.js 20+ and ensure it is on PATH.
# JS_RUNTIME_NODE=/absolute/path/to/node
# For high-quality YouTube and Bilibili DASH merging, both ffmpeg and ffprobe
# must be on PATH or placed together in this directory.
# FFMPEG_BIN_DIR=/absolute/path/to/bin
